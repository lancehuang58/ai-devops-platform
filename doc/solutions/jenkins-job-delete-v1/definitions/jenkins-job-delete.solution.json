{
  "schema_version": "1.0.0",
  "solution_id": "SOL-JENKINS-JOB-DELETE",
  "version": "1.0.0",
  "status": "DRAFT",
  "name": "備份並刪除單一 Jenkins Job",
  "request_type": "MAINTENANCE_REQUEST",
  "intent": "DELETE_JENKINS_JOB",
  "workflow_profile": "JENKINS_JOB_DELETE_V1",
  "input_contract": "contracts.schema.json#/$defs/Target",
  "max_targets": 1,
  "allowed_job_kinds": [
    "FREESTYLE",
    "PIPELINE"
  ],
  "exclude_multibranch_branch": true,
  "transport": "MCP",
  "authorization": {
    "required_role": "ADMIN",
    "confirmation_mode": "WHOLE_PLAN_ONCE",
    "after_step_id": "S10",
    "expires_after_seconds": 300,
    "recheck_before_each_step": true
  },
  "backup_policy": {
    "storage": "BOT_DATABASE",
    "content": "CONFIG_XML_ONLY",
    "verify": "COMMIT_READBACK_SHA256_AND_LENGTH",
    "retention_days": 90,
    "protect_unknown_or_pending_human": true,
    "raw_read_role": "ADMIN",
    "auto_restore": false
  },
  "execution_policy": {
    "retry_count": 0,
    "fallback_allowed": false,
    "auto_resume": false,
    "auto_rollback": false,
    "verify_after_fault": false,
    "max_delete_dispatches": 1,
    "max_verify_probes": 1,
    "max_external_calls": 6,
    "workflow_timeout_seconds": 180,
    "observation_max_age_seconds": 30,
    "final_config_max_age_seconds": 30,
    "max_config_bytes": 10485760,
    "report_mode": "FIXED_TEMPLATE",
    "lock_scope": "CONTROLLER_AND_FULL_JOB_NAME",
    "verification_timeout_seconds": 45,
    "settle_delay_seconds": 0,
    "poll_interval_seconds": null,
    "required_success_count": 1,
    "observation_duration_seconds": 0
  },
  "steps": [
    {
      "step_id": "S10",
      "kind": "COMMAND",
      "phase": "PREPARE",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-INSPECT",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "INITIAL_JOB_GATE"
    },
    {
      "step_id": "S20",
      "kind": "COMMAND",
      "phase": "EXECUTE",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-CONFIG-READ",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "COMPLETE_CONFIG_GATE"
    },
    {
      "step_id": "S30",
      "kind": "INTERNAL",
      "phase": "EXECUTE",
      "handler": "BACKUP_COMMIT_AND_READBACK",
      "input_bindings": {
        "config": "steps.S20.output"
      },
      "result_gate": "BACKUP_VERIFIED_GATE"
    },
    {
      "step_id": "S40",
      "kind": "COMMAND",
      "phase": "EXECUTE",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-CONFIG-READ",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "CONFIG_EQUALS_BACKUP_GATE"
    },
    {
      "step_id": "S50",
      "kind": "COMMAND",
      "phase": "EXECUTE",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-INSPECT",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "FINAL_JOB_GATE"
    },
    {
      "step_id": "S60",
      "kind": "COMMAND",
      "phase": "EXECUTE",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-DELETE",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "DELETE_ACK_GATE"
    },
    {
      "step_id": "S70",
      "kind": "COMMAND",
      "phase": "VERIFY",
      "command_ref": {
        "command_id": "CMD-JENKINS-JOB-VERIFY-ABSENT",
        "version": "1.0.0"
      },
      "input_bindings": {
        "target": "plan.target"
      },
      "result_gate": "AUTHORITATIVE_ABSENCE_GATE"
    }
  ],
  "final_report_contract": "contracts.schema.json#/$defs/ExecutionReport"
}
